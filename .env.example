# Copy to .env and fill in. Never commit .env (already in .gitignore).
# Look up AMI IDs per region: see docs/COOL-setup.md section 2.

AWS_REGION=ap-south-1

# Arm A: COOL Marketplace AMI. Subscribe/accept terms first, then:
#   aws ec2 describe-images --owners aws-marketplace \
#     --filters "Name=name,Values=*OpenCV*Graviton*" \
#     --query "Images[].{Id:ImageId,Name:Name}" --output table
COOL_AMI=

# Arm B: plain Ubuntu 24.04 arm64, same instance family as Arm A.
# This is the honest control -- only the library differs from Arm A.
UBUNTU_AMI_ARM64=

# Arm C: plain Ubuntu 24.04 amd64 for the hardware baseline.
UBUNTU_AMI_AMD64=

INSTANCE_ARM64=t4g.small
INSTANCE_X86=t3.small

# On-demand usd/hour for Arm A's instance type in your region, from the AWS
# pricing page. Left at 0 the cost column is reported as null rather than guessed.
USD_PER_HOUR_ARM64=0